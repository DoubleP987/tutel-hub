# Copy to .env; keep credentials private.
DISCORD_TOKEN=
# Bot UI language: th or en. Blank uses src/config/bot.js (Thai by default).
BOT_LANGUAGE=
BOT_WEBSITE_URL=https://tutelbot.vercel.app
CLIENT_ID=
GUILD_ID=
# Executable name or full path. Blank: prefer system FFmpeg on Linux, otherwise npm bundle.
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=
# Music searches default to YouTube. Change each guild in /music settings or the control panel.
CONTROL_HOST=127.0.0.1
CONTROL_PORT=3000
DATABASE_PATH=./data/tutel.sqlite
DATABASE_PROVIDER=sqlite
MONGODB_URI=
MONGODB_DATABASE=tutel
# false opens the cosmetic headphones indicator; no voice recording is enabled.
VOICE_SELF_DEAF=false
# Optional host override: soundcloud for Oracle. Blank uses per-guild settings.
MUSIC_SOURCE_OVERRIDE=
# Shared MongoDB failover: leave CLUSTER_NODE_ID blank for a standalone bot.
CLUSTER_NODE_ID=
CLUSTER_PRIMARY_NODE=homeserver
CLUSTER_CONTROL_SECRET=
BOT_CONTROL_USER_IDS=
DATA_DIR=./data
# Used only on a fresh database; blank generates a random initial password.
ADMIN_INITIAL_PASSWORD=
CALENDAR_SETUP_PIN=
PUBLIC_CALENDAR_URL=
PUBLIC_SITE_DIR=./vercel-public
# Optional automatic public-site deployment. Leave blank until configured.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

PUBLIC_DEPLOY_PROVIDER=calendar-api
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=tutel-calendar
VERCEL_TEAM_ID=

# Public calendar data sync (no deployments on event changes)
CALENDAR_SYNC_URL=https://your-project.vercel.app/api/calendar/sync
CALENDAR_SYNC_SECRET=

# Leave voice after this many seconds without humans (0 disables; max 3600).
VOICE_EMPTY_LEAVE_SECONDS=120
