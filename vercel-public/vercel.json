{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm ci --omit=dev",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/calendar.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/calendar",
      "destination": "/index.html"
    }
  ],
  "ignoreCommand": "if git log -1 --pretty=%B | grep -Fq '[skip vercel]'; then exit 0; else exit 1; fi",
  "redirects": [
    {
      "permanent": false,
      "destination": "https://calendar.toomtoom.online/",
      "source": "/"
    },
    {
      "permanent": false,
      "destination": "https://calendar.toomtoom.online/",
      "source": "/index.html"
    },
    {
      "permanent": false,
      "destination": "https://calendar.toomtoom.online/",
      "source": "/calendar"
    }
  ]
}
